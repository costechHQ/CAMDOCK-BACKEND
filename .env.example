# Copy to .env and set real values. Never commit .env.
# Use a URL-safe password (letters and digits); it is embedded in DATABASE_URL.
POSTGRES_USER=camdock
POSTGRES_PASSWORD=change-me
POSTGRES_DB=camdock

# Production only (docker-compose.prod.yml); see backend/docs/DEPLOYMENT.md.
# The domain name the proxy serves, already pointing at this server.
SITE_ADDRESS=portal.school.example
# Where the frontend is served from, comma-separated, https only. Empty means none.
CORS_ALLOWED_ORIGINS=
LOG_LEVEL=INFO
# Change both only if 172.28.0.0/24 is already used on this server.
# PROXY_SUBNET=172.28.0.0/24
# PROXY_IP=172.28.0.10
# Ports the proxy listens on.
# HTTP_PORT=80
# HTTPS_PORT=443
