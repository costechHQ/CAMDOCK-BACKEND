# Copy to .env and replace the placeholder values. Never commit .env.
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://camdock:change-me@localhost:5432/camdock
API_V1_PREFIX=/api/v1
SESSION_TTL_HOURS=12
SCHOOL_NAME=Camdock International School
SCHOOL_LOCATION=Enugu State, Nigeria
# Failed sign-ins: this many inside the window blocks that email (or address).
LOGIN_MAX_FAILURES=5
LOGIN_IP_MAX_FAILURES=20
LOGIN_WINDOW_MINUTES=15
LOGIN_BLOCK_MINUTES=15
# Proxy addresses or CIDR ranges whose X-Forwarded-For is believed. Leave empty unless
# the API sits behind a reverse proxy you control.
TRUSTED_PROXIES=
# Requests per minute per client address: /public/stats alone, and all endpoints
# together (/health is exempt).
RATE_LIMIT_PUBLIC_PER_MINUTE=30
RATE_LIMIT_GLOBAL_PER_MINUTE=300
